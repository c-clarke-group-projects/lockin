# Copy this file to .env and fill in real values.
# Never commit .env. Never put a real key, password or token in this file.

# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lockin

# Redis, used for live room state
REDIS_URL=redis://localhost:6379/0

# Host authentication
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=720

# Uploads
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_TYPES=application/pdf

# AI provider. Set AI_PROVIDER to gemini or ollama.
AI_PROVIDER=ollama
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3
AI_RETRY_BACKOFF_SECONDS=2
AI_MIN_QUESTIONS=5
AI_MAX_QUESTIONS=30

# Gemini, used for demos only
GEMINI_API_KEY=
GEMINI_MODEL=

# Ollama, used for daily development
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Live play
QUESTION_TIME_LIMIT_SECONDS=20
SCORE_BASE_POINTS=500
SCORE_SPEED_POINTS=500
JOIN_CODE_LENGTH=6

# Frontend, read by Vite. Only values that are safe in a browser belong here.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
